# Copy to .env and adjust. All values optional for local standalone use.

# API auth — when empty, all endpoints are OPEN (dev mode).
# Set to a long random string for any non-localhost exposure.
TITEN_API_KEY=

# Log level: trace, debug, info, warn, error
RUST_LOG=info

# Host port the Caddy proxy binds to (host:container)
TITEN_PROXY_PORT=7845

# Sentiment engine: stub (default), onnx, llm, custom_api
TITEN_SENTIMENT_ENGINE=stub

# Optional S3-compatible media storage (MinIO / R2 / AWS / etc.)
TITEN_S3_ENDPOINT=
TITEN_S3_BUCKET=
TITEN_S3_REGION=us-east-1
TITEN_S3_ACCESS_KEY=
TITEN_S3_SECRET_KEY=
TITEN_S3_PUBLIC_URL=
